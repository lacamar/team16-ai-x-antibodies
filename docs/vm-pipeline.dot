digraph vm_pipeline {
  rankdir=TB; bgcolor="#f5f4f0"; compound=true; splines=spline; nodesep=0.32; ranksep=0.6;
  labelloc="t"; fontname="Helvetica-Bold"; fontsize=26;
  label="Team 16 — pipeline inside the Apheris VM  (H100 80GB)";
  node [fontname="Helvetica", fontsize=15, shape=box, style="filled,rounded", fillcolor="white", color="#c9c6bd", margin="0.16,0.10"];
  edge [fontname="Helvetica", fontsize=12, color="#7d7a72"];

  // ================= INPUTS (top strip) =================
  subgraph cluster_in {
    label="models  ·  data  ·  weights  (on the shared VM)"; style="filled,rounded"; fillcolor="#eceae3"; color="#b7b2a4"; fontname="Helvetica-Bold"; fontsize=16;
    i_iglm [label="IgLM  (fine-tuned)\n~/laulau/runs/finetune/best", fillcolor="#efe3fb"];
    i_rfd  [label="RFD4-Proteina\nher2 · her2-novel", fillcolor="#efe3fb"];
    i_fold [label="Boltz-2 · OpenFold3\nco-fold", fillcolor="#efe3fb"];
    i_data [label="HER2 FACS 524k + SPR 768\n525,063 CDRH3 · 1N8Z ref", fillcolor="#eaf3f1"];
    { rank=same; i_iglm -> i_rfd -> i_fold -> i_data [style=invis]; }
  }

  // ================= PIPELINE (2-row serpentine) =================
  subgraph cluster_loop {
    label="generate → score → fold → rank   (reinforcement loop, on the GPU)"; style="filled,rounded"; fillcolor="#efeaf3"; color="#a98fc9"; fontname="Helvetica-Bold"; fontsize=17;

    g_ft   [label="finetune IgLM\n(RL on reward)", fillcolor="#dce6fb"];
    g_gen  [label="generate\noptimisation: CDRH3 variants\nde-novo: VHH backbones", fillcolor="#dce6fb"];
    g_seq  [label="sequence scorers  (no fold)\nsurrogate ρ=0.72 · novelty\nthermostability · hard gates", fillcolor="#dcf0e6"];
    g_rew  [label="reward\n(non-novel / red-flag = −10)", fillcolor="#dcf0e6"];
    g_pre  [label="prefilter →\ntop candidates", fillcolor="#fbe8cf"];

    g_fold [label="co-fold top ~10\nBoltz-2 / OpenFold3", fillcolor="#e7dcf7"];
    g_str  [label="structure gate\nepitope recall · ipTM (geom only)", fillcolor="#dcf0e6"];
    g_rank [label="rank", fillcolor="#d7f0df"];
    g_sub  [label="submit ≤20", fillcolor="#d7f0df"];

    // row 1 : finetune → generate → seq → reward → prefilter  (L→R)
    { rank=same; g_ft -> g_gen -> g_seq -> g_rew -> g_pre [style=invis]; }
    g_ft -> g_gen -> g_seq -> g_rew -> g_pre [constraint=false, penwidth=1.4];

    // drop to row 2
    g_pre -> g_fold [penwidth=1.4];

    // row 2 : co-fold → structure gate → rank → submit  (R→L serpentine)
    { rank=same; g_sub -> g_rank -> g_str -> g_fold [style=invis]; }
    g_fold -> g_str -> g_rank -> g_sub [constraint=false, penwidth=1.4];

    // reinforcement: scores drive finetuning, which re-seeds generation
    g_str -> g_ft [label="scores", color="#9b6ddb", penwidth=1.6, constraint=false];
    g_rew -> g_ft [color="#9b6ddb", style=dashed, constraint=false];
  }

  // ================= OUTPUTS (bottom) =================
  subgraph cluster_out {
    label="outputs"; style="filled,rounded"; fillcolor="#eceae3"; color="#b7b2a4"; fontname="Helvetica-Bold"; fontsize=16;
    o_top  [label="results/optimisation_top20.csv\nevery pick + written reason", fillcolor="#d7f0df"];
    o_dash [label="viz/ 3D dashboard\nhttp.server :8899 (SSH tunnel)", fillcolor="#eaf3f1"];
    { rank=same; o_top -> o_dash [style=invis]; }
  }

  // ================= feeds =================
  i_iglm -> g_ft   [style=dotted, color="#a98fc9"];
  i_rfd  -> g_gen  [style=dotted, color="#a98fc9", label="de-novo"];
  i_fold -> g_fold [style=dotted, color="#a98fc9"];
  i_data -> g_seq  [color="#1aa06d", label="trains surrogate · novelty · epitope"];

  g_sub -> o_top   [color="#5b8def", penwidth=1.6];
  g_str -> o_dash  [color="#5b8def", style=dashed, constraint=false];
}
