# --- secrets: never commit (hackathon hard rule) ---
*.private.json
credentials*.json
*.pem
*.key

# --- environments ---
.venv/
__pycache__/
*.pyc

# --- bulk data: downloaded from s3://apheris-oslo-hackathon/data/, not ours to vendor ---
data/
*.zip
*.tar
*.tar.zst

